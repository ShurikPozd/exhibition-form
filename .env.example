# Настройки приложения. Скопируй этот файл в .env и заполни под себя.
# Сам .env в репозиторий не попадает (.gitignore), поэтому секреты не утекут случайно.

# --- Запуск ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Хранилище ---
# Папка с файлом SQLite. По умолчанию ./data/submissions.db
# DATA_DIR=/app/data
# DATABASE_URL=sqlite:////app/data/submissions.db

# --- Доступ к админке и выгрузке ---
# ОБЯЗАТЕЛЬНО задай свой пароль: он вводится в форме на /admin/login.
ADMIN_PASSWORD=

# Случайная строка для машинного доступа (curl, скрипты): заголовок X-Export-Token
# или параметр ?token=. Без неё выгрузка для скриптов отдаёт 403.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
EXPORT_TOKEN=

# Сколько живёт сессия в админке после входа по паролю, часов.
SESSION_TTL_HOURS=8
# Secure-флаг cookie: 1 только на HTTPS. На http://127.0.0.1 оставь пустым.
SESSION_COOKIE_SECURE=

# --- Реквизиты оператора персональных данных ---
# Подставляются в текст согласия под чекбоксом.
CONSENT_OPERATOR_NAME=
CONSENT_OPERATOR_EMAIL=
CONSENT_OPERATOR_ADDRESS=

# --- Резервные копии ---
# Дампы базы всегда снимаются (после каждой заявки и по расписанию) в папку ниже.
BACKUP_DIR=./data/backup
# Сколько последних дампов хранить на диске.
BACKUP_KEEP=14
# Делать дамп сразу после приёма заявки: да, иначе копия отстаёт от данных.
BACKUP_ON_SUBMIT=1
# Как часто снимать дамп по расписанию, часов. 0 — отключить (нужно, если бэкапы
# не нужны вовсе, например на тестовом стенде).
BACKUP_INTERVAL_HOURS=6

# Выгрузка копии в приватный репозиторий GitHub — это то, что переживает пересоздание
# контейнера на Render. Обязательны обе строки, иначе копии остаются только на диске.
# Репозиторий: https://github.com/ShurikPozd/exhibition-form-backups
# BACKUP_REPO=ShurikPozd/exhibition-form-backups
# Токен: fine-grained PAT на этот репозиторий, Contents: Read and write.
# Создать: https://github.com/settings/personal-access-tokens/new
# BACKUP_TOKEN=github_pat_...
