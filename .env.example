# Настройки приложения. Скопируй этот файл в .env и заполни под себя.
# Сам .env в репозиторий не попадает (.gitignore), поэтому секреты не утекут случайно.

# --- Запуск ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Хранилище ---
# Папка с файлом SQLite. По умолчанию ./data/submissions.db
# DATA_DIR=/app/data
# DATABASE_URL=sqlite:////app/data/submissions.db

# --- Доступ к админке и выгрузке ---
# ОБЯЗАТЕЛЬНО задай свой пароль: он вводится в форме на /admin/login.
ADMIN_PASSWORD=

# Случайная строка для машинного доступа (curl, скрипты): заголовок X-Export-Token
# или параметр ?token=. Без неё выгрузка для скриптов отдаёт 403.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
EXPORT_TOKEN=

# Сколько живёт сессия в админке после входа по паролю, часов.
SESSION_TTL_HOURS=8
# Secure-флаг cookie: 1 только на HTTPS. На http://127.0.0.1 оставь пустым.
SESSION_COOKIE_SECURE=

# --- Реквизиты оператора персональных данных ---
# Подставляются в текст согласия под чекбоксом.
CONSENT_OPERATOR_NAME=
CONSENT_OPERATOR_EMAIL=
CONSENT_OPERATOR_ADDRESS=
